{
  "version": 1,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rootDirectory": ".",
  "routing": {
    "spaFallback": true
  },
  "headers": [
    {
      "source": "/*",
      "values": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN"
      }
    }
  ]
}
